# Demo mode is deterministic and does not call an external LLM.
DEMO_MODE=true
API_CORS_ORIGINS=http://localhost:3000
POSTGRES_DB=controlplane
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=change-me-for-non-demo-use
DATABASE_URL=sqlite:///./controlplane.db
REDIS_URL=redis://localhost:6379/0
# Optional provider configuration. Leave blank in demo mode.
LLM_API_KEY=
